{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hours.fun/api/:path*"
    },
    {
      "source": "/_assets/:path*",
      "destination": "https://hours.fun/_assets/:path*"
    },
    {
      "source": "/brand/:path*",
      "destination": "https://hours.fun/brand/:path*"
    },
    {
      "source": "/launch",
      "destination": "/launch.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/how-it-works.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "framework": null
}